# Copy to .env and fill in values. Never commit .env.

# Google Gemini (official @google/genai SDK). Never expose this to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
DATABASE_URL=postgresql://acl:acl@127.0.0.1:5433/agentcrashlab?schema=public

# Redis / BullMQ (local dev — docker compose up redis)
# Omit on Render: test runs execute in-process in the API without Redis.
REDIS_URL=redis://localhost:6379

# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite). Leave empty for local dev (uses Vite /api proxy).
# For split deploy (e.g. Vercel frontend), set to your API URL.
VITE_API_URL=http://localhost:4000

# Production (Render): NODE_ENV=production, DATABASE_URL from Neon.
# REDIS_URL is optional — leave unset on Render to avoid Upstash; set locally for BullMQ worker.
# CORS_ORIGIN not needed when API serves the built frontend (same origin).
