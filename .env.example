# Copy to .env and fill in values. Never commit .env.

# Google Gemini (official @google/genai SDK). Never expose this to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
DATABASE_URL=postgresql://acl:acl@127.0.0.1:5433/agentcrashlab?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
