{
  "name": "agent-crash-lab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @acl/api",
    "dev:worker": "npm run dev -w @acl/worker",
    "dev:web": "npm run dev -w @acl/web",
    "build": "npm run build -w @acl/web && npm run build -w @acl/api && npm run build -w @acl/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "prisma:validate": "prisma validate",
    "start:prod": "tsx scripts/bootstrap-prod.ts && concurrently -n api,worker \"npm run start -w @acl/api\" \"npm run start -w @acl/worker\""
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
